# ============================================================
# 🦞⚡ NeoClaw — Environment Variables Reference
# Copy this to .env and fill in your values
# ============================================================

# ─── Required ───────────────────────────────────────────────
# Your LLM provider API key (Anthropic, OpenAI, OpenRouter, etc.)
LLM_API_KEY=sk-your-api-key-here

# Model to use (provider/model format)
LLM_MODEL=openai/gpt-4o

# Password to secure your NeoClaw Control UI
GATEWAY_TOKEN=your-strong-password-here

# ─── Platform (auto-detected) ──────────────────────────────
# NEOCLAW_PLATFORM=huggingface  # huggingface|railway|render|flyio|heroku|local

# ─── HuggingFace Backup (Optional) ────────────────────────
HF_USERNAME=
HF_TOKEN=
BACKUP_DATASET_NAME=neoclaw-backup
SYNC_INTERVAL=180

# ─── Telegram (Optional) ──────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=
# TELEGRAM_USER_IDS=123456,789012  # Comma-separated for team access

# ─── WhatsApp (Optional) ──────────────────────────────────
WHATSAPP_ENABLED=false

# ─── Discord (Optional) ───────────────────────────────────
DISCORD_TOKEN=

# ─── Slack (Optional) ─────────────────────────────────────
SLACK_TOKEN=

# ─── Voice Support (Optional) ─────────────────────────────
VOICE_ENABLED=false
# ELEVENLABS_API_KEY=

# ─── Local Models via Ollama (Optional) ───────────────────
OLLAMA_ENABLED=false
# OLLAMA_BASE_URL=http://localhost:11434

# ─── Keep-Alive ───────────────────────────────────────────
UPTIMEROBOT_API_KEY=
CRONJOB_ORG_KEY=
NEOCLAW_EXTERNAL_URL=https://your-space.hf.space
SELF_PING_INTERVAL=300000

# ─── Webhooks (Optional) ──────────────────────────────────
WEBHOOK_URL=

# ─── Security (Optional) ──────────────────────────────────
OPENCLAW_PASSWORD=
TRUSTED_PROXIES=
ALLOWED_ORIGINS=https://your-space.hf.space

# ─── GitHub Gist Backup (Optional) ────────────────────────
GITHUB_GIST_TOKEN=
GITHUB_GIST_ID=

# ─── S3 Backup (Optional) ─────────────────────────────────
S3_BACKUP_BUCKET=
S3_REGION=us-east-1
